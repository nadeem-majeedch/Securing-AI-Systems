# artefact-integrity lab; a clone without them cannot run Module 15.
!labs/datasets/model_bundle/*.safetensors
!labs/datasets/model_bundle_tampered/*.safetensors

# --- Build output ------------------------------------------------------------
site/
.cache/
*.log
.pages-test/
# --- Deployment ---------------------------------------------------------------
